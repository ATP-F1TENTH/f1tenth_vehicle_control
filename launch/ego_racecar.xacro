<?xml version="1.0"?>

<!-- A simple model of the racecar for rviz -->

<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="racecar">


  <xacro:property name="ground_offset" value="0.04" />
  <xacro:property name="wheel_radius" value="0.04" />
  <xacro:property name="laser_distance_from_base_link_x" value="0.35" />
  <xacro:property name="laser_height" value="0.05" />
  <xacro:property name="laser_radius" value="0.026" />
  <xacro:property name="camera_distance_from_base_link_x" value="0.194" />
  <xacro:property name="camera_distance_from_base_link_y" value="0.04" />
  <xacro:property name="camera_distance_from_base_link_z" value="0.1108" />
  <xacro:property name="camera_height" value="0.05" />
  <xacro:property name="camera_radius" value="0.026" />
  <xacro:property name="car_name" value="porsche911" />

  <xacro:property name="wheelbase" value="0.326" />
  <xacro:property name="axis_back_z" value="0.0014" />
  <xacro:property name="axis_back_x" value="0.144" />
  <xacro:property name="axis_front_x" value="0.198" />
  <xacro:property name="track_front" value="0.238" />
  <xacro:property name="track_back" value="0.252" />
  <xacro:property name="wheel_length_front" value="0.035" />
  <xacro:property name="wheel_length_back" value="0.047" />

  <material name="black">
    <color rgba="0.2 0.2 0.2 1."/>
  </material>

  <material name="blue">
    <color rgba="0.3 0.57 1. 1."/>
  </material>

  <link name="base_link">
    <visual>
      <origin xyz="${axis_back_x} 0  ${ground_offset+axis_back_z}" rpy=" 0 0 ${pi/2}"/>
      <geometry>
        <mesh filename="package://remote_rviz/launch/911_body_paw.dae" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="blue"/>
    </visual>
  </link>

  <joint name="base_to_laser_model" type="fixed">
    <parent link="base_link"/>
    <child link="laser"/>
    <origin xyz="${laser_distance_from_base_link_x} 0 ${ground_offset+(laser_height/2)}"/>
  </joint>

  <link name="laser">
    <visual>
      <geometry>
        <cylinder radius="${laser_radius}" length="${laser_height}"/>
      </geometry>
      <material name="black"/>
    </visual>
  </link>

  <link name="${car_name}/camera">
    <visual>
      <geometry>
        <cylinder radius="${camera_radius}" length="${camera_height}"/>
      </geometry>
      <origin xyz="0 0 0" rpy=" 0 0 0"/>
      <material name="black"/>
    </visual>
  </link>

  <joint name="base_to_camera" type="fixed">
    <parent link="base_link"/>
    <child link="${car_name}/camera"/>
    <origin xyz="${camera_distance_from_base_link_x} ${camera_distance_from_base_link_y} ${ground_offset+camera_distance_from_base_link_z}" rpy=" ${-pi/2+0.087} 0 ${-pi/2}"/>
  </joint>

  <joint name="$base_to_back_left_wheel" type="fixed">
    <parent link="base_link"/>
    <child link="${car_name}/back_left_wheel"/>
    <origin xyz="0 ${track_back/2} ${ground_offset}"/>
  </joint>

  <link name="${car_name}/back_left_wheel">
    <visual>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_length_back}"/>
      </geometry>
      <material name="black"/>
      <origin rpy="${pi/2} 0 0"/>
    </visual>
  </link>

  <joint name="base_to_back_right_wheel" type="fixed">
    <parent link="base_link"/>
    <child link="${car_name}/back_right_wheel"/>
    <origin xyz="0 ${-track_back/2} ${ground_offset}"/>
  </joint>

  <link name="${car_name}/back_right_wheel">
    <visual>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_length_back}"/>
      </geometry>
      <material name="black"/>
      <origin rpy="${pi/2} 0 0"/>
    </visual>
  </link>

  <joint name="base_to_front_left_hinge" type="fixed">
    <parent link="base_link"/>
    <child link="${car_name}/front_left_hinge"/>
    <origin xyz="${wheelbase} ${track_front/2} ${ground_offset}"/>
  </joint>

  <link name="${car_name}/front_left_hinge"/>

  <joint name="front_left_hinge_to_wheel" type="continuous">
    <parent link="${car_name}/front_left_hinge"/>
    <child link="${car_name}/front_left_wheel"/>
  </joint>

  <link name="${car_name}/front_left_wheel">
    <visual>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_length_front}"/>
      </geometry>
      <material name="black"/>
      <origin rpy="${pi/2} 0 0"/>
    </visual>
  </link>

  <joint name="base_to_front_right_hinge" type="fixed">
    <parent link="base_link"/>
    <child link="${car_name}/front_right_hinge"/>
    <origin xyz="${wheelbase} ${-track_front/2} ${ground_offset}"/>
  </joint>

  <link name="${car_name}/front_right_hinge"/>

  <joint name="front_right_hinge_to_wheel" type="continuous">
    <parent link="${car_name}/front_right_hinge"/>
    <child link="${car_name}/front_right_wheel"/>
  </joint>

  <link name="${car_name}/front_right_wheel">
    <visual>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_length_front}"/>
      </geometry>
      <material name="black"/>
      <origin rpy="${pi/2} 0 0"/>
    </visual>
  </link>

</robot>

<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>vehicle_control</name>
  <version>0.0.0</version>
  <description>MUX for controlling an F1tenth vehicle</description>
  <maintainer email="Philip.Wette@hsbi.de">Philip Wette</maintainer>
  <license>MIT</license>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>ackermann_msgs</exec_depend>
  <exec_depend>joy_linux</exec_depend>
  <exec_depend>aesthetic_control</exec_depend>
  <exec_depend>camera_ros</exec_depend>

  <!-- <depend>vehicle_control_interfaces</depend> -->
  
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
